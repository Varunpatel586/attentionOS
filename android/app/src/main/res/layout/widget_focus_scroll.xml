<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_toggle_bg"
    android:orientation="horizontal"
    android:padding="6dp"
    android:baselineAligned="false">

    <LinearLayout
        android:id="@+id/focusSection"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_toggle_active">

        <TextView
            android:id="@+id/focusTimeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2h 28m"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/focusTimeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Focusing"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/scrollSection"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@android:color/transparent">

        <TextView
            android:id="@+id/scrollTimeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1h 40m"
            android:textSize="22sp"
            android:textColor="#000000"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/scrollTimeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scrolling"
            android:textSize="14sp"
            android:textColor="#353535"
            android:fontFamily="sans-serif"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>